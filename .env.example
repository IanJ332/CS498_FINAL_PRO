# AI Dashboard Configuration
# Copy this file to .env and fill in your keys

# --- NVIDIA NIM (AI Search) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- MongoDB (Real-time Data) ---
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=your_mongodb_connection_string_here

# --- Google Cloud (BigQuery) ---
# The backend expects a file named: final-492902-b95cff0ffa0e.json in the root directory
# You can change the PROJECT_ID in app.py if needed.
